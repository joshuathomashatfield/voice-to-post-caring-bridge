# Copy this file to .env and adjust values as needed.
# Never commit a real .env file with secrets.

# --- General ---
HOST=127.0.0.1
PORT=8000
DEBUG=false

# --- Speech-to-text (faster-whisper) ---
STT_MODEL=small.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
MIN_SPEECH_SECONDS=0.5
TRAILING_SILENCE_SECONDS=1.2
MAX_RECORDING_SECONDS=120

# --- Text-to-speech ---
ENABLE_TTS=true
TTS_ENGINE=browser
# PIPER_VOICE_PATH=/path/to/voice.onnx

# --- LLM backend ---
# LLM_PROVIDER=ollama | openai_compatible | none
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# If LLM_PROVIDER=openai_compatible:
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=sk-...

LLM_TEMPERATURE=0.4
LLM_REQUEST_TIMEOUT=60

# --- Session / privacy ---
ENABLE_AUTOSAVE=true
ENABLE_RESEARCH_MODE=false
SESSION_TTL_MINUTES=240

# --- Draft generation ---
DRAFT_TARGET_MIN_WORDS=150
DRAFT_TARGET_MAX_WORDS=350
